# Copy this file to .env.local and fill in your keys

# Google Maps — enable these APIs in your project:
#   - Places API (New)
#   - Geocoding API
# LOCAL DEV ONLY: in `vite` dev the browser calls Google directly with this key.
# In production the browser never sees it — it calls the /api/places proxy, which
# uses GOOGLE_MAPS_API_KEY below (server-side). Safe to leave this dev key here.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Supabase — project URL + anon (public) key. Client-side; safe to expose.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Analytics — handled by Vercel Web Analytics (free). No env var needed; just
# enable "Web Analytics" in the Vercel project dashboard. Only collects on the
# deployed site (no-op in dev).

# Error monitoring (optional) — Sentry DSN. Leave blank to disable; the SDK is
# only downloaded when a DSN is present.
VITE_SENTRY_DSN=

# ── Server-side only (NO VITE_ prefix — never shipped to the browser) ──

# Google Maps key used by the /api/places proxy. Set this in Vercel so the key
# never ships in the browser bundle. Give it an API restriction (Places API New
# + Geocoding API) and a daily quota cap — but do NOT add an HTTP-referrer
# restriction (calls come from the server, which sends no Referer). If unset, the
# proxy falls back to VITE_GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_API_KEY=your_server_google_maps_api_key_here

# How long decision-room data (rooms/swipes/rankings) is kept before the nightly
# cron prunes it. Optional — defaults to 30 days.
RETENTION_DAYS=30

# TMDB read access token — powers the movie catalog + "where to watch" data.
# Used by scripts/refresh-movies.mjs and the /api/refresh-movies cron function.
TMDB_READ_TOKEN=your_tmdb_v4_read_access_token_here

# Supabase service-role key — lets the refresh job write to movie_catalog,
# bypassing RLS. Server-side secret; set in Vercel env, never commit.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Guards the /api/refresh-movies cron endpoint. Vercel Cron sends this as
# `Authorization: Bearer <CRON_SECRET>` automatically when set. Any random string.
CRON_SECRET=your_random_cron_secret_here
